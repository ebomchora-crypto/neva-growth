# Porta HTTP
PORT=3000
# Pasta do banco SQLite (padrão: ./data)
DATA_DIR=./data
# Defina como "1" atrás de HTTPS para cookies Secure
COOKIE_SECURE=0

# IA (opcional) — habilita assistente da IDE e geração de sites com IA
ANTHROPIC_API_KEY=
NEVA_AI_MODEL=claude-sonnet-5-5

# Prospecção de clientes (opcional) — Google Places API (New)
GOOGLE_PLACES_API_KEY=
