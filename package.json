{
  "name": "neva-growth",
  "version": "1.0.0",
  "description": "Neva Growth \u2014 plataforma de CRM, vendas, cursos, cria\u00e7\u00e3o de sites e IDE com IA.",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "test:e2e": "node test/e2e/ui.e2e.mjs",
    "build:codemaker": "esbuild server/lib/codemaker/src/engine.ts --bundle --platform=node --format=cjs --target=node22 --outfile=server/lib/codemaker/engine.js --legal-comments=none",
    "test:e2e:builder": "node test/e2e/builder.e2e.mjs",
    "build:design": "node scripts/compile-design.js",
    "build:ui-kit": "node ui-kit-react/build.mjs"
  },
  "dependencies": {
    "@neon/config": "^1.9.2",
    "@neon/env": "^1.6.3",
    "@sparticuz/chromium": "^138.0.2",
    "express": "^4.21.2",
    "express-async-errors": "^3.1.1",
    "gsap": "^3.15.0",
    "pg": "^8.23.1",
    "playwright-core": "^1.64.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@electric-sql/pglite-socket": "^0.2.13",
    "@tailwindcss/cli": "4.1.11",
    "clsx": "2.1.1",
    "esbuild": "^0.24.2",
    "lucide-react": "0.400.0",
    "motion": "11.12.0",
    "postcss": "8.4.49",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-use-measure": "2.1.1",
    "tailwind-merge": "2.6.0",
    "tailwindcss": "4.1.11"
  }
}
