# Porta HTTP
PORT=3000
# Pasta do banco SQLite (padrão: ./data)
DATA_DIR=./data
# Defina como "1" atrás de HTTPS para cookies Secure
COOKIE_SECURE=0

# IA (opcional) — habilita assistente da IDE e geração de sites com IA
RIVER_API_KEY=
RIVER_MODEL=deepseek-ai/DeepSeek-V4.1-Flash
# legado (usado só sem RIVER_API_KEY)
ANTHROPIC_API_KEY=
NEVA_AI_MODEL=claude-sonnet-5-5

# Prospecção de clientes (opcional) — Google Places API (New)
GOOGLE_PLACES_API_KEY=

# ---- Produção (Vercel + Supabase) ----
# Postgres: use a string do "Transaction pooler" (porta 6543) do Supabase → Connect. Sem DATABASE_URL o app usa PGlite local (só dev).
DATABASE_URL=
# Obrigatório na Vercel: token exigido na criação do primeiro administrador
SETUP_TOKEN=
# Opcional: segredo dos links de preview (por padrão é derivado de DATABASE_URL)
PREVIEW_SECRET=

# Provedor de IA só do Builder de sites (opcional). Com CODEMAKER_API_KEY preenchida, o Code Maker usa este provedor
# (API compatível com a OpenAI) em vez da River. URL e modelo têm padrão; preencha só se quiser mudar.
# CODEMAKER_API_KEY=
# CODEMAKER_BASE_URL=https://inference.dahl.global/v1
# CODEMAKER_MODEL=zai-org/GLM-5.3-Flash
